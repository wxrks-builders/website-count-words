# Every variable the app reads. This file is the authoritative list — set the
# same keys in whatever runs the container. See DEPLOY.md for the requirements
# that aren't environment variables (persistent disk, one worker, proxy headers).

# ---- required ---------------------------------------------------------------

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Every hostname the app is served on needs its own authorised redirect URI,
# because the callback is built from the incoming request:
#   http://localhost:8000/auth/callback
#   https://wordcounter.wxrks.app/auth/callback
#   https://markdown.wxrks.app/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Changing it logs everyone out.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Where the SQLite database lives. Its parent directory also holds saved
# Markdown, so it must be on a persistent volume — see DEPLOY.md.
DB_PATH=data/wordcount.db

# ---- security ---------------------------------------------------------------

# Marks the session cookie Secure. Defaults to true; set false ONLY for local
# development over plain http, or sign-in will not work there.
SECURE_COOKIES=false

# ---- hostnames --------------------------------------------------------------

# The two front doors, matched against the request's Host header
# (app/surfaces.py). Anything else falls back to the counter.
COUNTER_HOST=wordcounter.wxrks.app
MARKDOWN_HOST=markdown.wxrks.app

# Used to build links in notification emails when no surface is known.
PUBLIC_BASE_URL=http://localhost:8000

# A finished, public run to show on each landing page. Unset hides the button.
COUNTER_DEMO_RUN_ID=
MARKDOWN_DEMO_RUN_ID=

# The run copied into every new account so the first sign-in isn't empty.
# Matched by URL, so re-crawling that site refreshes what new users see.
SAMPLE_RUN_URL=https://wxrks.com

# ---- email ------------------------------------------------------------------

# Mailgun — sends a summary when a crawl finishes, fails or is stopped.
# Leave blank to disable email entirely; nothing else breaks.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional: defaults to "Word Counter <noreply@MAILGUN_DOMAIN>"
MAILGUN_FROM=

# ---- limits -----------------------------------------------------------------

# The crawler polls its own RSS and stops a crawl before it reaches this,
# rather than being OOM-killed. Set it below the container's memory limit.
MEMORY_LIMIT_MB=3200

# Saved Markdown. Capture stops on its own before the volume gets tight,
# because the database shares it — filling it takes the whole app down.
MARKDOWN_MAX_RUN_MB=300
MARKDOWN_MAX_TOTAL_MB=6000
MARKDOWN_DISK_FLOOR_MB=512
# Defaults to a "markdown" directory beside DB_PATH.
MARKDOWN_DIR=

# ---- admin ------------------------------------------------------------------

# Comma-separated Google account emails allowed to see /admin/runs,
# /admin/jobs and /admin/estimates. Everyone else gets a plain 404.
ADMIN_EMAILS=
