# Every variable the app reads. This file is the authoritative list — set the
# same keys in whatever runs the container. See DEPLOY.md for the requirements
# that aren't environment variables (persistent disk, one worker, proxy headers).

# ---- required ---------------------------------------------------------------

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Every hostname the app is served on needs its own authorised redirect URI,
# because the callback is built from the incoming request:
#   http://localhost:8000/auth/callback
#   https://wordcounter.wxrks.app/auth/callback
#   https://markdown.wxrks.app/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Changing it logs everyone out.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Where the SQLite database lives. Its parent directory also holds saved
# Markdown, so it must be on a persistent volume — see DEPLOY.md.
DB_PATH=data/wordcount.db

# ---- security ---------------------------------------------------------------

# Marks the session cookie Secure. Defaults to true; set false ONLY for local
# development over plain http, or sign-in will not work there.
SECURE_COOKIES=false

# ---- hostnames --------------------------------------------------------------

# The two front doors, matched against the request's Host header
# (app/surfaces.py). Anything else falls back to the counter.
COUNTER_HOST=wordcounter.wxrks.app
MARKDOWN_HOST=markdown.wxrks.app

# Used to build links in notification emails when no surface is known.
PUBLIC_BASE_URL=http://localhost:8000

# A finished, public run to show on each landing page. Unset hides the button.
COUNTER_DEMO_RUN_ID=
MARKDOWN_DEMO_RUN_ID=

# The run copied into every new account so the first sign-in isn't empty.
# Matched by URL, so re-crawling that site refreshes what new users see.
SAMPLE_RUN_URL=https://wxrks.com

# ---- email ------------------------------------------------------------------

# Mailgun — sends a summary when a crawl finishes, fails or is stopped.
# Leave blank to disable email entirely; nothing else breaks.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional: defaults to "Word Counter <noreply@MAILGUN_DOMAIN>"
MAILGUN_FROM=

# ---- limits -----------------------------------------------------------------

# The crawler polls its own RSS and stops a crawl before it reaches this,
# rather than being OOM-killed. Set it below the container's memory limit —
# roughly three quarters of it, leaving room for the spike a Chromium page
# makes while it renders.
MEMORY_LIMIT_MB=12000

# ---- crawl speed ------------------------------------------------------------
#
# How many pages a crawl fetches at once. This is the number that decides how
# long a crawl takes: roughly (pages / concurrency) x 2.9s. See app/plans.py.
CRAWL_CONCURRENCY_FREE=4
CRAWL_CONCURRENCY_PRO=16

# The ceiling on pages in flight across *all* running crawls at once. Each crawl
# gets its own dispatcher and can't see the others, so without this a few Pro
# crawls together would swamp the CPU. Size it to the box: roughly 4 per vCPU is
# a reasonable starting point (24 on 6 vCPUs).
CRAWL_PAGE_BUDGET=24

# How many crawls may run at the same time. Total page load is bounded by
# CRAWL_PAGE_BUDGET above, so this is about how many people are served at once
# rather than how hard the box is pushed.
MAX_CONCURRENT_CRAWLS=4

# ---- promotion --------------------------------------------------------------

# Where the wxrks banner on shared reports points. That banner appears only on
# a shared (public) report of the word counter — the one surface that reaches
# people who aren't users — and only for a site with enough words to be a real
# translation project. See app/promos.py.
WXRKS_URL=https://wxrks.com
WXRKS_MIN_WORDS=5000

# How slow a finished crawl has to have been before its report mentions Pro.
# Below this, "faster" isn't a problem the person had.
PRO_UPSELL_MIN_SECONDS=600

# ---- billing (Stripe) -------------------------------------------------------
#
# Leave STRIPE_SECRET_KEY blank to disable billing entirely: the pricing and
# checkout routes 404 and everyone crawls at the free speed. Nothing else
# breaks — same degradation as MAILGUN_API_KEY above.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Without it every webhook is rejected, so a paid subscription never
# reaches the database.
STRIPE_WEBHOOK_SECRET=
# The recurring price the Pro plan checks out against (price_..., not prod_...).
STRIPE_PRICE_ID=

# Saved Markdown. Capture stops on its own before the volume gets tight,
# because the database shares it — filling it takes the whole app down.
MARKDOWN_MAX_RUN_MB=300
MARKDOWN_MAX_TOTAL_MB=6000
MARKDOWN_DISK_FLOOR_MB=512
# Defaults to a "markdown" directory beside DB_PATH.
MARKDOWN_DIR=

# ---- admin ------------------------------------------------------------------

# Comma-separated Google account emails allowed to see /admin/runs,
# /admin/jobs and /admin/estimates. Everyone else gets a plain 404.
ADMIN_EMAILS=
